{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorized": {
      "type": "boolean"
    },
    "confirmed": {
      "minimum": 0,
      "type": "integer"
    },
    "count": {
      "minimum": 0,
      "type": "integer"
    },
    "coverage": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "domain": {
      "maxLength": 80,
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "event": {
      "enum": [
        "invocation_started",
        "change_classified",
        "dependent_count",
        "authority_conflict",
        "versioning_gap",
        "proposal_result",
        "invocation_finished"
      ],
      "type": "string"
    },
    "event_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^(?!.*\\.\\.).+$",
        "type": "string"
      },
      "type": "array"
    },
    "execution_snapshot_id": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "failed": {
      "minimum": 0,
      "type": "integer"
    },
    "lane": {
      "maxLength": 80,
      "type": "string"
    },
    "lens": {
      "maxLength": 80,
      "type": "string"
    },
    "matched": {
      "minimum": 0,
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "started",
        "passed",
        "failed",
        "blocked",
        "skipped",
        "recovered",
        "not_applicable"
      ],
      "type": "string"
    },
    "parent_event_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "reason_code": {
      "pattern": "^[a-z0-9_.-]{1,80}$",
      "type": "string"
    },
    "refuted": {
      "minimum": 0,
      "type": "integer"
    },
    "retries": {
      "minimum": 0,
      "type": "integer"
    },
    "reviewer": {
      "maxLength": 80,
      "type": "string"
    },
    "run_id": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "skill": {
      "const": "propose-contract-change"
    },
    "skill_revision": {
      "pattern": "^[a-f0-9]{16}$",
      "type": "string"
    },
    "skipped": {
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "maxLength": 80,
      "type": "string"
    },
    "surface": {
      "maxLength": 80,
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "uow_id": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "timestamp",
    "run_id",
    "sequence",
    "parent_event_hash",
    "event_hash",
    "skill",
    "skill_revision",
    "event",
    "outcome",
    "reason_code"
  ],
  "title": "propose-contract-change telemetry",
  "type": "object"
}
